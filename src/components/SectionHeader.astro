---
interface Props {
  title: string;
  label?: string;
}

const { title, label } = Astro.props;
---

<header class="mb-5">
  {label && (
    <div class="flex items-center gap-2 text-accent mb-2">
      <span class="flex size-4 items-center justify-center" aria-hidden="true">
        <slot name="icon" />
      </span>
      <span class="text-xs font-semibold uppercase tracking-wider">{label}</span>
    </div>
  )}
  <h2 class="text-xl md:text-2xl font-semibold tracking-tight text-primary">{title}</h2>
</header>
